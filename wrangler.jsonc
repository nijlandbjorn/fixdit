{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fixdit-ai",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  "preview_urls": true,
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "3e15b0a7-e315-4a39-9ad4-73662aa61083"
      }
    ],
    "vars": {
      "RESEARCH_ENABLED": "false"
    },
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
